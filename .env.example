ENV=prod
MAX_BLOB_SIZE=524288

PASTEBIN_DB_USER=user
PASTEBIN_DB_NAME=pastebin
PASTEBIN_DB_PASSWORD=change-me
PASTEBIN_FLUSH_INTERVAL=5s
PASTEBIN_DELETE_INTERVAL=10s
PASTEBIN_SHUTDOWN_TIMEOUT=10s
PASTEBIN_DB_MAX_CONNS=50
PASTEBIN_PASTE_CACHE_TTL=1h

GATEWAY_DB_USER=user
GATEWAY_DB_NAME=gateway
GATEWAY_DB_PASSWORD=change-me
GATEWAY_DB_MAX_CONNS=50
GATEWAY_WRITE_TIMEOUT=4s
GATEWAY_CHECK_TIMEOUT=5s

REDIS_MAX_MEMORY=1024mb
POSTGRES_MAX_CONNS=200
